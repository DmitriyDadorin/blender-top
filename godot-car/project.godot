; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Palmshift"
config/version="0.1.3"
config/description="Побережье, пустыня и ночной город — поездки в атмосфере вечного лета."
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Машина — первый проект"
config/icon="res://assets/drive_icon.svg"
boot_splash/image="res://assets/palmshift_splash.png"
boot_splash/bg_color=Color(0.075,0.065,0.16,1)
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/minimum_display_time=1200
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1100
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.16, 0.2, 0.25, 1)

anti_aliasing/quality/msaa_3d=2

; Avoid headlight shadow banding on surfaces near the 64 m beam range.
lights_and_shadows/positional_shadow/atlas_16_bits=false
